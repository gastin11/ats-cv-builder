# ATS CV Builder — backend environment
# Copy to .env and fill in real values. Never commit real keys to source control.

PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info

# Comma-separated allowlist of frontend origins.
# Add your tunnel or deployment URL here if running remotely.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application upload limits (MB)
MAX_FILE_MB_DOC=10
MAX_FILE_MB_IMAGE=10

# --- OCR.Space (https://ocr.space/ocrapi) ---
# Dapatkan API key gratis di https://ocr.space/ocrapi
OCR_SPACE_API_KEY=your_ocr_space_api_key_here
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
# Engine 2 default, Engine 3 fallback (per PRD baseline)
OCR_SPACE_DEFAULT_ENGINE=2
OCR_SPACE_FALLBACK_ENGINE=3
OCR_SPACE_LANGUAGE=auto
OCR_TIMEOUT_MS=60000
# Provider-side limits — adjust to the values that apply to your OCR.Space plan
OCR_MAX_FILE_MB=5
OCR_MAX_PDF_PAGES=3

# --- AI writing assistance (OpenAI-compatible endpoint) ---
# Endpoint yang kompatibel dengan format OpenAI (OpenAI, DeepSeek, Qwen, OpenRouter, dll.)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BACKUP_BASE_URL=
AI_BACKUP_API_KEY=
AI_BACKUP_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=1200

# PDF text-layer threshold: below this many extracted characters a PDF is
# treated as scanned and routed to OCR
PDF_MIN_TEXT_CHARS=200

RATE_LIMIT_MAX=100

# Free translation API (MyMemory, no key required). An email raises the daily quota.
TRANSLATE_ENDPOINT=https://api.mymemory.translated.net/get
TRANSLATE_EMAIL=
TRANSLATE_GOOGLE_ENDPOINT=https://clients5.google.com/translate_a/t
# Optional: DeepL API Free key (500k chars/month) as final fallback
DEEPL_API_KEY=
